@model Story_Blog.Models.Blog
@{
    ViewBag.Title = "CreateBlog";
    Layout = "~/Views/Shared/_ServerLayout.cshtml";
}

<div class="container">


    @using (Html.BeginForm("CreateBlog", "Blog", FormMethod.Post))
    {
        <div class="form-group mt-4">
            <label>Başlık</label>
            @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
        </div>
        <div class="form-group mt-4">
            <label>Ön Yazı</label>
            @Html.TextBoxFor(x => x.CoverLetter, new { @class = "form-control" })
        </div>
        <div class="form-group mt-4">
            <label>Resim Url</label>
            @Html.TextBoxFor(x => x.ImageUrl, new { @class = "form-control" })
        </div>
        <div class="form-group mt-4">
            <label>Blog İçerik</label>
            @Html.TextAreaFor(x => x.BlogContent, new { @class = "form-control" })
        </div>
        <div class="form-group mt-4">
            <label>Oluşturma Tarihi</label>
            @Html.TextBoxFor(x => x.DateCreated, new { @class = "form-control", @type = "datetime-local", Value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") })
        </div>
        <div class="form-group mt-4">
            <label>Oluşturma Tarihi</label>

            @Html.DropDownList("UserId", (List<SelectListItem>)ViewBag.AuthorList, htmlAttributes: new { @class = "form-control", Value = ViewBag.AuthorId })
        </div>
        <div class="form-group mt-4">
            <button class="btn btn-success" type="submit">Blogu kaydet</button>
        </div>
    }

</div>


