
@{
    ViewBag.Title = "EditBlogPost";
    Layout = "~/Views/Shared/_ServerLayout.cshtml";
}
@model Story_Blog.Models.Blog

<div class="container">
    @using (Html.BeginForm("EditBlog", "Blog", FormMethod.Post))
    {
        <div class="form-group mt-4">
            <label>Başlık</label>
            @Html.TextBoxFor(model => model.Title, htmlAttributes: new { @class = "form-control" })
        </div>

        <div class="form-group mt-4">
            <label>Ön Yazı</label>
            @Html.TextBoxFor(model => model.CoverLetter, htmlAttributes: new { @class = "form-control" })
        </div>

        <div class="form-group mt-4">
            <label>Resim Yolu</label>
            @Html.TextBoxFor(model => model.ImageUrl, htmlAttributes: new { @class = "form-control" })
        </div>

        <div class="form-group mt-4">
            <label>İçerik</label>
            @Html.TextAreaFor(model => model.BlogContent, htmlAttributes: new { @class = "form-control" })
        </div>

        <div class="form-group mt-4">
            <label>Oluşturma Tarihi</label>
            @Html.TextBoxFor(model => model.DateCreated, htmlAttributes: new { @class = "form-control", @type = "datetime-local", Value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") })
        </div>

        <div class="form-group mt-4">
            <label>Yazar</label>
            @Html.DropDownList("userId", (List<SelectListItem>)ViewBag.AuthorList, htmlAttributes: new { @class = "form-control", required = "", Value = ViewBag.AuthorId })
        </div>

        <div class="form-group mt-4">
            <button class="btn btn-warning">Değişiklikleri Kaydet</button>
        </div>
        <div>
            @ViewBag.Text
        </div>
    }
</div>

