@model Story_Blog.Models.Author

@{
    ViewBag.Title = "EditAuthor";
    Layout = "~/Views/Shared/_ServerLayout.cshtml";
}



@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class=" container">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })


        <div class="form-group mt-4">
            <label class="control-label col-md-2">İsim</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control w-100" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mt-4">
            <label class="control-label col-md-2">E Posta</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mt-4">
            <label class="control-label col-md-2">Şifre</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group mt-4">
            <div class="col-md-10">
                <label class="control-label col-md-2">Rol</label>
                @Html.DropDownListFor(m => m.Role,
       new SelectList(Enum.GetValues(typeof(Story_Blog.Models.Role))
           .Cast<Story_Blog.Models.Role>()
           .Select(r => new { Value = (int)r, Text = r.ToString() }),
       "Value", "Text", Story_Blog.Models.Role.Admin),
       new { @class = "form-control", required = "" })

            </div>
        </div>


        <div class="form-group mt-4">
            <div class="col-md-offset-2 col-md-10 mb-4">
                <input type="submit" value="Kaydet" class="btn btn-warning" />
            </div>
        </div>
        <div>
            @Html.ActionLink("Anasayfaya Dön", "Index", null, new { @class = "btn btn-primary" })
        </div>
    </div>
}


