@model Story_Blog.Models.Comment
@{
    ViewBag.Title = "CreateComment";
    Layout = "~/Views/Shared/_ServerLayout.cshtml";
}

<div class="container mt-4">
    @using (Html.BeginForm("CreateComment", "Comment", FormMethod.Post))
    {
        <div class="form-group mt-4">
            <label class="mb-2">Blog</label>
            @Html.DropDownList("BlogId", (List<SelectListItem>)ViewBag.BlogList, htmlAttributes: new { @class = "form-control" })
        </div>

        <div class="form-group mt-4">
            <label class="mb-2">Yorum İçeriği</label>
            @Html.TextAreaFor(m => m.CommentContent, new { @class = "form-control" })
        </div>

        <div class="form-group mt-4">
            <label class="mb-2">Oluşturma Tarihi</label>
            @Html.TextBoxFor(x => x.DateCreated, new { @class = "form-control", @type = "datetime-local", Value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") })
        </div>

        <div class="form-group mt-4">
            <label class="mb-2">Yazar</label>
            @Html.DropDownList("UserId", (List<SelectListItem>)ViewBag.AuthorList, htmlAttributes: new { @class = "form-control" })
        </div>

        <div class="form-group mt-4">
            <button class="btn btn-success" type="submit">Yorum Ekle</button>
        </div>
    }
</div>

