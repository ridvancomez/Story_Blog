@model Story_Blog.Models.Comment

@{
    ViewBag.Title = "EditComment";
    Layout = "~/Views/Shared/_ServerLayout.cshtml";
}

<h2>EditComment</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Comment</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)

        <div class="form-group mt-4">
            <label class="mb-1">İçerik</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.CommentContent, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CommentContent, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mt-4">
            <label class="mb-1">Oluşturma Tarihi</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.DateCreated, new { htmlAttributes = new { @class = "form-control", @type = "datetime-local", Value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") } })
                @Html.ValidationMessageFor(model => model.DateCreated, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mt-4">
            <label class="mb-1">Yazar</label>
            <div class="col-md-10">
                @Html.DropDownList("AuthorId", (List<SelectListItem>)ViewBag.AuthorList, htmlAttributes: new { @class = "form-control", Value = ViewBag.AuthorId })
                @Html.ValidationMessageFor(model => model.AuthorId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mt-4">
            <label class="mb-1">Blog</label>
            <div class="col-md-10">
                @Html.DropDownList("BlogId", (List<SelectListItem>)ViewBag.BlogList, htmlAttributes: new { @class = "form-control", Value = ViewBag.BlogId })
                @Html.ValidationMessageFor(model => model.BlogId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mt-4">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Kaydet" class="btn btn-warning" />
            </div>
        </div>
    </div>
}
